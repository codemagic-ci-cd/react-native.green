---
import { overviewCell, type Package, type ReactNativeLine } from '../../lib/compat';
import { REQUEST_URL } from '../../lib/links';
import { isRc } from '../../lib/view';

interface Props {
  packages: Package[];
  reactNative: ReactNativeLine[];
}

const { packages, reactNative } = Astro.props;

const CELL_LABEL = { no: 'No', untested: 'Untested' } as const;
---

<div class="packages-card card">
  <div class="scroll-frame" data-scroll-frame>
  <div class="table-scroll" data-table-scroll data-scroll-start="end">
    <table style={`--cols: ${reactNative.length}`}>
      <caption class="sr-only">Newest release of each package that works on each React Native version</caption>
      <colgroup>
        <col class="col-package" />
        {reactNative.map(() => <col />)}
      </colgroup>
      <thead>
        <tr>
          <th scope="col" rowspan="2" class="package-head">
            <span class="corner-axis mobile-only" aria-hidden="true">React Native &rarr;</span>Package
          </th>
          <th scope="colgroup" colspan={reactNative.length} class="axis-top">
            <span class="axis">
              <span class="desktop-only">React Native version</span>
              <span class="sr-only mobile-only">React Native version</span>
            </span>
          </th>
        </tr>
        <tr>
          {
            reactNative.map((rn) => (
              <th scope="col" class="rn-head">
                <span class="rn-head-inner">
                  <span>{rn.line}</span>
                  {isRc(rn) && <span class="rc-tag">RC</span>}
                </span>
              </th>
            ))
          }
        </tr>
      </thead>
      <tbody>
        {
          packages.map((pkg) => (
            <tr data-package-row data-name={pkg.name.toLowerCase()}>
              <th scope="row" class="package">
                <a href={`/${pkg.name}/`} class="package-name on-surface">
                  {pkg.name}
                </a>
                <span class="package-latest mono truncate" title={pkg.lines[0]?.version}>latest {pkg.lines[0]?.version}</span>
              </th>
              {reactNative.map((rn) => {
                const cell = overviewCell(pkg, rn.line);
                return (
                  <td>
                    <div class:list={['cell', `cell-${cell.kind}`]}>
                      {cell.kind === 'latest' || cell.kind === 'older' ? `${cell.line}.x` : CELL_LABEL[cell.kind]}
                      {cell.kind === 'older' && <span class="sr-only"> (older release)</span>}
                    </div>
                  </td>
                );
              })}
            </tr>
          ))
        }
      </tbody>
    </table>
  </div>
  </div>
  <div aria-live="polite">
    <p class="empty" data-search-empty hidden>No packages match</p>
  </div>

  <div id="request" class="request">
    <p>More packages are on the way. Tell us which library you depend on.</p>
    <a href={REQUEST_URL}>Request a package</a>
  </div>

  <div class="legend">
    <div class="legend-item"><span class="swatch swatch-yes"></span><span>Latest release works</span></div>
    <div class="legend-item"><span class="swatch swatch-older"></span><span>An older release works</span></div>
    <div class="legend-item"><span class="swatch swatch-no"></span><span>No release works</span></div>
    <div class="legend-item"><span class="swatch swatch-queued"></span><span>Untested</span></div>
  </div>
</div>

<style>
  .packages-card {
    padding: 28px 32px;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  /* The pinned package column plus its 3px gap; the left scroll fade starts after it. */
  .scroll-frame {
    --pinned: 303px;
  }

  /* Positioned so visually hidden text inside the table stays inside the scroller instead of
     widening the page. */
  .table-scroll {
    position: relative;
    margin: -3px;
    overflow-x: auto;
  }

  /* Columns never shrink below 72px; past that the table scrolls inside its card. */
  table {
    width: 100%;
    min-width: calc(300px + var(--cols) * 72px + (var(--cols) + 2) * 3px);
    table-layout: fixed;
    border-collapse: separate;
    border-spacing: 3px;
  }

  .col-package {
    width: 300px;
  }

  th,
  td {
    padding: 0;
  }

  /* Names the columns; the label is sticky, so it stays in view while they scroll. */
  .axis-top {
    height: 20px;
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .axis {
    display: inline-block;
    position: sticky;
    left: calc(var(--pinned) + 8px);
  }

  /* On phones the pinned column leaves no room beside it for the label above, so it moves into
     the corner, at the top and right, next to the columns it names. */
  .corner-axis {
    position: absolute;
    top: 0;
    right: 8px;
  }

  .package-head {
    height: 36px;
    vertical-align: bottom;
    text-align: left;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .rn-head-inner {
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 5px;
    font-size: 15px;
    font-weight: 600;
    color: var(--text);
  }

  .rn-head .rc-tag {
    color: var(--rc);
  }

  .package-head,
  .package {
    position: sticky;
    left: 3px;
    z-index: 1;
    background: var(--card);
    box-shadow:
      -3px 0 0 var(--card),
      3px 0 0 var(--card);
  }

  .package {
    height: 72px;
    padding-right: 12px;
    text-align: left;
    font-weight: 400;
    vertical-align: middle;
  }

  .package-name {
    display: block;
    font-size: 16px;
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .package-latest {
    display: block;
    margin-top: 2px;
    font-size: 12px;
    color: var(--muted);
  }

  .cell {
    height: 72px;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
  }

  .cell-latest {
    background: var(--yes-bg);
    color: var(--yes-text);
  }

  /* Outlined rather than filled, so an older release differs from the latest by shape too. */
  .cell-older {
    background: var(--older-bg);
    box-shadow: inset 0 0 0 1px var(--older-border);
    color: var(--older-text);
  }

  .cell-no {
    background: var(--no-bg);
    color: var(--no-text);
  }

  .cell-untested {
    background: var(--queued-bg);
    color: var(--queued-text);
  }

  .empty {
    padding: 24px 0;
    text-align: center;
    font-size: 15px;
    color: var(--muted);
  }

  .request {
    min-height: 60px;
    margin-top: 9px;
    padding: 0 20px;
    display: flex;
    align-items: center;
    gap: 12px;
    border: 1px dashed var(--dashed);
    border-radius: 6px;
  }

  .request p {
    flex-grow: 1;
    font-size: 14px;
    color: var(--muted);
  }

  .request a {
    height: 44px;
    line-height: 44px;
    flex-shrink: 0;
    font-size: 14px;
    font-weight: 600;
  }

  .legend {
    margin-top: 17px;
    flex-wrap: wrap;
    gap: 8px 28px;
  }

  @media (max-width: 767px) {
    .packages-card {
      padding: 16px 0 20px 16px;
    }

    .table-scroll {
      margin: -3px 0 -3px -3px;
      padding-right: 13px;
    }

    .scroll-frame {
      --pinned: 183px;
    }

    .col-package {
      width: 180px;
    }

    table {
      min-width: calc(180px + var(--cols) * 64px + (var(--cols) + 2) * 3px);
    }

    .package-name {
      font-size: 15px;
    }

    .request {
      margin-right: 16px;
      padding: 8px 16px;
      flex-wrap: wrap;
      gap: 0 12px;
    }

    .legend {
      padding-right: 16px;
      gap: 8px 20px;
    }
  }
</style>
