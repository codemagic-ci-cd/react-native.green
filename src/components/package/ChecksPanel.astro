---
import { cellKind, cellResult, formatTestedDate, type Package, type ReactNativeLine } from '../../lib/compat';
import { CHECKS, OUTCOME_ICON, OUTCOME_LABEL, outcomeOf, rnTitle, STATUS_LABEL } from '../../lib/view';
import Icon from '../Icon.astro';

interface Props {
  pkg: Package;
  reactNative: ReactNativeLine[];
  selectedRn: string;
  selectedLine: string;
}

const { pkg, reactNative, selectedRn, selectedLine } = Astro.props;

// Every cell's details are rendered now; the browser only toggles `hidden`.
const panels = pkg.lines.flatMap((line) =>
  reactNative.map((rn) => {
    const result = cellResult(pkg, line.line, rn.line);
    return {
      key: `${line.line}@${rn.line}`,
      selected: line.line === selectedLine && rn.line === selectedRn,
      title: `${line.line}.x on React Native ${rnTitle(rn)}`,
      kind: cellKind(pkg, line.line, rn.line),
      checks: CHECKS.map((check) => ({ name: check.name, outcome: outcomeOf(result?.checks[check.key]) })),
      library: result?.tested.library ?? line.version,
      reactNative: result?.tested.reactNative ?? rn.version,
      testedAt: result ? `tested ${formatTestedDate(result.testedAt)}` : 'not run yet',
      buildUrl: result?.buildUrl,
    };
  }),
);
---

<section aria-label="Checks for the selected cell" class="panel card">
  {
    panels.map((panel) => (
      <div class="detail" data-checks={panel.key} hidden={!panel.selected}>
        <div class="detail-head">
          <h2>{panel.title}</h2>
          <div class:list={['status', `status-${panel.kind}`]} data-status>{STATUS_LABEL[panel.kind]}</div>
        </div>
        <ul class="checks">
          {panel.checks.map((check) => (
            <li class="check">
              <span class:list={['check-icon', `outcome-${check.outcome}`]}>
                <Icon name={OUTCOME_ICON[check.outcome]} size={14} strokeWidth={check.outcome === 'wait' ? 2 : 2.4} />
              </span>
              <span class="check-name">{check.name}</span>
              <span class:list={['check-result', `text-${check.outcome}`]}>{OUTCOME_LABEL[check.outcome]}</span>
            </li>
          ))}
        </ul>
        <div class="detail-foot">
          <div class="tested mono">
            <span>library {panel.library}</span>
            <span>react-native {panel.reactNative}</span>
            <span>{panel.testedAt}</span>
          </div>
          {panel.buildUrl ? (
            <a href={panel.buildUrl} class="log">
              View build log on Codemagic
            </a>
          ) : (
            <span class="log-pending">Build log appears after the first run</span>
          )}
        </div>
      </div>
    ))
  }
</section>

<style>
  .panel {
    padding: 28px 32px;
  }

  .detail {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .detail-head {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  h2 {
    flex-grow: 1;
    font-size: 19px;
    line-height: 1.35;
    font-weight: 600;
    color: var(--text);
  }

  .status {
    height: 28px;
    line-height: 28px;
    padding: 0 12px;
    flex-shrink: 0;
    border-radius: 14px;
    font-size: 13px;
    font-weight: 600;
  }

  .status-yes {
    background: var(--yes-bg);
    color: var(--yes-text);
  }

  .status-no {
    background: var(--no-bg);
    color: var(--no-text);
  }

  .status-queued {
    background: var(--wait-bg);
    color: var(--status-queued-text);
  }

  .checks {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .check {
    height: 52px;
    display: flex;
    align-items: center;
    gap: 14px;
    border-top: 1px solid var(--rule);
  }

  .check-icon {
    width: 24px;
    height: 24px;
    flex-shrink: 0;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .outcome-pass {
    background: var(--pass-bg);
    color: var(--pass-icon);
  }

  .outcome-fail {
    background: var(--fail-bg);
    color: var(--fail-icon);
  }

  .outcome-wait {
    background: var(--wait-bg);
    color: var(--wait-icon);
  }

  .check-name {
    flex-grow: 1;
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
  }

  .check-result {
    font-size: 14px;
    font-weight: 500;
  }

  .text-pass {
    color: var(--pass-text);
  }

  .text-fail {
    color: var(--fail-text);
  }

  .text-wait {
    color: var(--wait-text);
  }

  /* Stacked: the tested versions and date on one line, the build log below them. */
  .detail-foot {
    min-width: 0;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding-top: 12px;
    border-top: 1px solid var(--rule);
  }

  .tested {
    max-width: 100%;
    overflow-wrap: anywhere;
    display: flex;
    flex-wrap: wrap;
    gap: 0 20px;
    font-size: 12px;
    color: var(--muted);
  }

  .log,
  .log-pending {
    height: 44px;
    line-height: 44px;
    font-size: 14px;
  }

  .log {
    font-weight: 600;
  }

  .log-pending {
    color: var(--muted);
  }
</style>
